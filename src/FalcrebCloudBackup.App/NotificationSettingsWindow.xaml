<mah:MetroWindow x:Class="FalcrebCloudBackup.App.NotificationSettingsWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
                 xmlns:loc="clr-namespace:FalcrebCloudBackup.App.Localization"
                 Title="{loc:Tr NotifyWin_Title}"
                 Icon="pack://application:,,,/Assets/logo_icon.png"
                 TitleCharacterCasing="Normal"
                 Width="560" Height="720"
                 MinWidth="480" MinHeight="500"
                 WindowStartupLocation="CenterOwner">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24">
            <TextBlock Text="{loc:Tr NotifyWin_Title}" FontSize="20" FontWeight="Light" Margin="0,0,0,4" />
            <TextBlock TextWrapping="Wrap" Opacity="0.7" Margin="0,0,0,16"
                       Text="{loc:Tr NotifyWin_Intro}" />

            <Border BorderThickness="1" BorderBrush="{DynamicResource MahApps.Brushes.Gray7}" Padding="16" Margin="0,0,0,12" CornerRadius="6">
                <StackPanel>
                    <TextBlock Text="{loc:Tr NotifyWin_When}" FontWeight="SemiBold" Margin="0,0,0,8" />
                    <CheckBox x:Name="NotifyOnFailureCheck" Content="{loc:Tr NotifyWin_OnFailure}" Margin="0,3" />
                    <CheckBox x:Name="NotifyWhenStaleCheck" Content="{loc:Tr NotifyWin_WhenStale}" Margin="0,3" />
                    <CheckBox x:Name="NotifyOnSuccessCheck" Content="{loc:Tr NotifyWin_OnSuccess}" Margin="0,3" />
                </StackPanel>
            </Border>

            <Border BorderThickness="1" BorderBrush="{DynamicResource MahApps.Brushes.Gray7}" Padding="16" Margin="0,0,0,12" CornerRadius="6">
                <StackPanel>
                    <CheckBox x:Name="EmailEnabledCheck" Content="{loc:Tr NotifyWin_EmailEnabled}" FontWeight="SemiBold" Checked="OnChannelToggled" Unchecked="OnChannelToggled" Margin="0,0,0,8" />
                    <StackPanel x:Name="EmailPanel">
                        <TextBlock Text="{loc:Tr NotifyWin_Provider}" FontSize="11" Opacity="0.7" Margin="0,0,0,4" />
                        <ComboBox x:Name="PresetCombo" SelectionChanged="OnPresetChanged" Margin="0,0,0,8">
                            <ComboBoxItem Content="Gmail" Tag="smtp.gmail.com|587" />
                            <ComboBoxItem Content="Outlook / Hotmail" Tag="smtp-mail.outlook.com|587" />
                            <ComboBoxItem Content="{loc:Tr NotifyWin_PresetM365}" Tag="smtp.office365.com|587" />
                            <ComboBoxItem Content="Yahoo" Tag="smtp.mail.yahoo.com|587" />
                            <ComboBoxItem Content="{loc:Tr NotifyWin_PresetCustom}" Tag="" />
                        </ComboBox>
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="90" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="{loc:Tr NotifyWin_SmtpHost}" FontSize="11" Opacity="0.7" Margin="0,0,0,4" />
                                <TextBox x:Name="SmtpHostBox" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Port" FontSize="11" Opacity="0.7" Margin="0,0,0,4" />
                                <TextBox x:Name="SmtpPortBox" />
                            </StackPanel>
                            <CheckBox Grid.Column="4" x:Name="SmtpSslCheck" Content="{loc:Tr NotifyWin_Tls}" VerticalAlignment="Bottom" Margin="0,0,0,8" IsChecked="True" />
                        </Grid>
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="{loc:Tr NotifyWin_User}" FontSize="11" Opacity="0.7" Margin="0,0,0,4" />
                                <TextBox x:Name="SmtpUserBox" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="{loc:Tr NotifyWin_Password}" FontSize="11" Opacity="0.7" Margin="0,0,0,4" />
                                <PasswordBox x:Name="SmtpPasswordBox" />
                            </StackPanel>
                        </Grid>
                        <TextBlock Text="{loc:Tr NotifyWin_From}" FontSize="11" Opacity="0.7" Margin="0,0,0,4" />
                        <TextBox x:Name="FromBox" Margin="0,0,0,8" />
                        <TextBlock Text="{loc:Tr NotifyWin_To}" FontSize="11" Opacity="0.7" Margin="0,0,0,4" />
                        <TextBox x:Name="ToBox" Margin="0,0,0,8" />
                        <TextBlock x:Name="EmailHintText" FontSize="11" Opacity="0.6" TextWrapping="Wrap"
                                   Text="{loc:Tr NotifyWin_EmailHint}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border BorderThickness="1" BorderBrush="{DynamicResource MahApps.Brushes.Gray7}" Padding="16" Margin="0,0,0,12" CornerRadius="6">
                <StackPanel>
                    <CheckBox x:Name="TelegramEnabledCheck" Content="{loc:Tr NotifyWin_TelegramEnabled}" FontWeight="SemiBold" Checked="OnChannelToggled" Unchecked="OnChannelToggled" Margin="0,0,0,8" />
                    <StackPanel x:Name="TelegramPanel">
                        <TextBlock Text="Bot token" FontSize="11" Opacity="0.7" Margin="0,0,0,4" />
                        <PasswordBox x:Name="TelegramTokenBox" Margin="0,0,0,8" />
                        <TextBlock Text="Chat ID" FontSize="11" Opacity="0.7" Margin="0,0,0,4" />
                        <TextBox x:Name="TelegramChatIdBox" Margin="0,0,0,8" />
                        <TextBlock FontSize="11" Opacity="0.6" TextWrapping="Wrap"
                                   Text="{loc:Tr NotifyWin_TelegramHint}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <TextBlock x:Name="StatusText" TextWrapping="Wrap" Margin="0,0,0,12" />

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" x:Name="TestButton" Content="{loc:Tr NotifyWin_Test}" Click="OnTestClick" />
                <Button Grid.Column="2" Content="{loc:Tr Common_Cancel}" Click="OnCancelClick" Margin="0,0,8,0" />
                <Button Grid.Column="3" Content="{loc:Tr Common_Save}" Click="OnSaveClick" />
            </Grid>
        </StackPanel>
    </ScrollViewer>
</mah:MetroWindow>
