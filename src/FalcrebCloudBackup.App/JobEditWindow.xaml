<mah:MetroWindow x:Class="FalcrebCloudBackup.App.JobEditWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
                 xmlns:loc="clr-namespace:FalcrebCloudBackup.App.Localization"
                 Title="{loc:Tr JobEdit_Title}"
                 Icon="pack://application:,,,/Assets/logo_icon.png"
                 TitleCharacterCasing="Normal"
                 Width="540" Height="720"
                 MinWidth="480" MinHeight="500"
                 WindowStartupLocation="CenterOwner">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24">

            <TextBlock Text="{loc:Tr JobEdit_Name}" FontWeight="SemiBold" Margin="0,0,0,4" />
            <TextBox x:Name="NameBox" Margin="0,0,0,16" />

            <TextBlock Text="{loc:Tr JobEdit_Source}" FontWeight="SemiBold" Margin="0,0,0,4" />
            <TextBox x:Name="SourcePathBox" IsReadOnly="True" Margin="0,0,0,4" />
            <TextBlock x:Name="SourceSizeText" Opacity="0.7" FontSize="11" Margin="0,0,0,8" TextWrapping="Wrap" />
            <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                <Button Content="{loc:Tr JobEdit_PickFolder}" Click="OnPickFolderClick" Margin="0,0,8,0" />
                <Button Content="{loc:Tr JobEdit_PickFile}" Click="OnPickFileClick" />
            </StackPanel>

            <!-- Yalnızca kaynakta Firebird veritabanı (.fdb/.gdb) bulunduğunda görünür. -->
            <Border x:Name="FirebirdPanel" Visibility="Collapsed" BorderThickness="1" BorderBrush="{DynamicResource MahApps.Brushes.Gray7}"
                    Padding="14" Margin="0,0,0,16" CornerRadius="6">
                <StackPanel>
                    <TextBlock Text="{loc:Tr Firebird_Title}" FontWeight="SemiBold" Margin="0,0,0,4" />
                    <TextBlock x:Name="FirebirdInfoText" TextWrapping="Wrap" Opacity="0.75" FontSize="11" Margin="0,0,0,8" />
                    <CheckBox x:Name="GbakCheck" Content="{loc:Tr Firebird_GbakCheck}" Checked="OnGbakToggled" Unchecked="OnGbakToggled" Margin="0,0,0,8" />
                    <StackPanel x:Name="GbakDetailsPanel">
                        <TextBlock Text="{loc:Tr Firebird_GbakPath}" FontSize="11" Opacity="0.7" Margin="0,0,0,4" />
                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" x:Name="GbakPathBox" TextChanged="OnGbakPathChanged" />
                            <Button Grid.Column="1" Content="{loc:Tr Firebird_Find}" Click="OnFindGbakClick" Margin="8,0,0,0" Padding="12,6" />
                            <Button Grid.Column="2" Content="{loc:Tr Firebird_Browse}" Click="OnBrowseGbakClick" Margin="8,0,0,0" Padding="12,6" />
                        </Grid>
                        <TextBlock x:Name="GbakStatusText" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,8" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="{loc:Tr Firebird_User}" FontSize="11" Opacity="0.7" Margin="0,0,0,4" />
                                <TextBox x:Name="FbUserBox" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="{loc:Tr Firebird_Password}" FontSize="11" Opacity="0.7" Margin="0,0,0,4" />
                                <PasswordBox x:Name="FbPasswordBox" />
                            </StackPanel>
                        </Grid>
                        <TextBlock Text="{loc:Tr Firebird_DefaultsHint}"
                                   FontSize="11" Opacity="0.6" TextWrapping="Wrap" Margin="0,6,0,0" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <TextBlock Text="{loc:Tr JobEdit_SendTo}" FontWeight="SemiBold" Margin="0,0,0,4" />
            <Grid Margin="0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <CheckBox Grid.Column="0" x:Name="GoogleDriveCheck" Content="Google Drive" Checked="OnDestinationToggled" Unchecked="OnDestinationToggled" />
                <TextBlock Grid.Column="1" x:Name="GoogleDriveStatusText" Opacity="0.7" FontSize="11" HorizontalAlignment="Right" VerticalAlignment="Center" />
            </Grid>
            <TextBlock Text="{loc:Tr JobEdit_GoogleFolder}" FontSize="11" Opacity="0.7" Margin="0,0,0,4" />
            <TextBox x:Name="GoogleDriveFolderBox" Margin="0,0,0,8" />
            <Grid Margin="0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <CheckBox Grid.Column="0" x:Name="OneDriveCheck" Content="OneDrive" Checked="OnDestinationToggled" Unchecked="OnDestinationToggled" />
                <TextBlock Grid.Column="1" x:Name="OneDriveStatusText" Opacity="0.7" FontSize="11" HorizontalAlignment="Right" VerticalAlignment="Center" />
            </Grid>
            <TextBlock Text="{loc:Tr JobEdit_OneDriveFolder}" FontSize="11" Opacity="0.7" Margin="0,0,0,4" />
            <TextBox x:Name="OneDriveFolderBox" Margin="0,0,0,16" />

            <TextBlock Text="{loc:Tr JobEdit_Schedule}" FontWeight="SemiBold" Margin="0,0,0,4" />
            <ComboBox x:Name="FrequencyCombo" SelectionChanged="OnFrequencyChanged" Margin="0,0,0,8">
                <ComboBoxItem Content="{loc:Tr JobEdit_FreqHourly}" Tag="Hourly" />
                <ComboBoxItem Content="{loc:Tr JobEdit_FreqDaily}" Tag="Daily" />
                <ComboBoxItem Content="{loc:Tr JobEdit_FreqWeekly}" Tag="Weekly" />
            </ComboBox>

            <StackPanel x:Name="DayOfWeekPanel" Orientation="Horizontal" Margin="0,0,0,8">
                <TextBlock Text="{loc:Tr JobEdit_Day}" VerticalAlignment="Center" Margin="0,0,8,0" />
                <ComboBox x:Name="DayOfWeekCombo" Width="140">
                    <ComboBoxItem Content="{loc:Tr Day_Monday}" Tag="Monday" />
                    <ComboBoxItem Content="{loc:Tr Day_Tuesday}" Tag="Tuesday" />
                    <ComboBoxItem Content="{loc:Tr Day_Wednesday}" Tag="Wednesday" />
                    <ComboBoxItem Content="{loc:Tr Day_Thursday}" Tag="Thursday" />
                    <ComboBoxItem Content="{loc:Tr Day_Friday}" Tag="Friday" />
                    <ComboBoxItem Content="{loc:Tr Day_Saturday}" Tag="Saturday" />
                    <ComboBoxItem Content="{loc:Tr Day_Sunday}" Tag="Sunday" />
                </ComboBox>
            </StackPanel>

            <StackPanel x:Name="TimeOfDayPanel" Orientation="Horizontal" Margin="0,0,0,16">
                <TextBlock Text="{loc:Tr JobEdit_Time}" VerticalAlignment="Center" Margin="0,0,8,0" />
                <ComboBox x:Name="HourCombo" Width="70" Margin="0,0,8,0" />
                <ComboBox x:Name="MinuteCombo" Width="70" />
            </StackPanel>

            <TextBlock Text="{loc:Tr JobEdit_Options}" FontWeight="SemiBold" Margin="0,0,0,4" />
            <CheckBox x:Name="EnabledCheck" Content="{loc:Tr JobEdit_Enabled}" Margin="0,4" IsChecked="True" />
            <CheckBox x:Name="WatchCheck" Content="{loc:Tr JobEdit_Watch}" Margin="0,4" IsChecked="True" />
            <TextBlock x:Name="WatchHintText" Visibility="Collapsed" FontSize="11" Opacity="0.6" TextWrapping="Wrap" Margin="24,0,0,4"
                       Text="{loc:Tr JobEdit_WatchHint}" />
            <CheckBox x:Name="CatchUpCheck" Content="{loc:Tr JobEdit_CatchUp}" Margin="0,4" IsChecked="True" />
            <TextBlock FontSize="11" Opacity="0.6" TextWrapping="Wrap" Margin="24,0,0,4"
                       Text="{loc:Tr JobEdit_CatchUpHint}" />
            <CheckBox x:Name="ZipCheck" Content="{loc:Tr JobEdit_Zip}" Margin="0,4" IsChecked="True" />
            <CheckBox x:Name="VerifyCheck" Content="{loc:Tr JobEdit_Verify}" Margin="0,4" IsChecked="True" />
            <CheckBox x:Name="TimestampCheck" Content="{loc:Tr JobEdit_Timestamp}" Margin="0,4,0,16" IsChecked="True" />

            <TextBlock x:Name="ErrorText" Foreground="Red" TextWrapping="Wrap" Margin="0,0,0,8" />

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="{loc:Tr Common_Cancel}" Click="OnCancelClick" Margin="0,0,8,0" />
                <Button Content="{loc:Tr Common_Save}" Click="OnSaveClick" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</mah:MetroWindow>
