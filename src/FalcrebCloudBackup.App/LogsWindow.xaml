<mah:MetroWindow x:Class="FalcrebCloudBackup.App.LogsWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
                 xmlns:loc="clr-namespace:FalcrebCloudBackup.App.Localization"
                 Title="{loc:Tr Logs_Title}"
                 Icon="pack://application:,,,/Assets/logo_icon.png"
                 TitleCharacterCasing="Normal"
                 Width="760" Height="560"
                 WindowStartupLocation="CenterOwner">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="{loc:Tr Logs_Title}" FontSize="20" FontWeight="Light" Margin="0,0,0,4" />
        <TextBlock Grid.Row="1" x:Name="SubtitleText" Opacity="0.7" FontSize="11" Margin="0,0,0,12" TextWrapping="Wrap" />

        <Border Grid.Row="2" BorderThickness="1" BorderBrush="{DynamicResource MahApps.Brushes.Gray7}">
            <ScrollViewer x:Name="LogScrollViewer" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                <TextBox x:Name="LogText"
                         IsReadOnly="True"
                         TextWrapping="NoWrap"
                         FontFamily="Consolas"
                         FontSize="11"
                         BorderThickness="0"
                         Background="Transparent" />
            </ScrollViewer>
        </Border>

        <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,16,0,0">
            <Button Content="{loc:Tr Common_Refresh}" Click="OnRefreshClick" Margin="0,0,8,0" />
            <Button Content="{loc:Tr Logs_OpenFolder}" Click="OnOpenFolderClick" Margin="0,0,8,0" />
            <Button Content="{loc:Tr Common_Close}" Click="OnCloseClick" />
        </StackPanel>
    </Grid>
</mah:MetroWindow>
