<mah:MetroWindow x:Class="FalcrebCloudBackup.App.HistoryWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
                 xmlns:loc="clr-namespace:FalcrebCloudBackup.App.Localization"
                 Title="{loc:Tr History_Title}"
                 Icon="pack://application:,,,/Assets/logo_icon.png"
                 TitleCharacterCasing="Normal"
                 Width="680" Height="600"
                 MinWidth="520" MinHeight="400"
                 WindowStartupLocation="CenterOwner">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="{loc:Tr History_Title}" FontSize="20" FontWeight="Light" Margin="0,0,0,4" />
        <TextBlock Grid.Row="1" x:Name="SubtitleText" Opacity="0.7" FontSize="11" Margin="0,0,0,12" TextWrapping="Wrap" />

        <!--
            HorizontalScrollBarVisibility="Disabled" olmadan liste satırları sonsuz genişlik alır ve
            TextWrapping hiç devreye girmez — uzun hata mesajları yatay kaydırma çubuğuyla kesiliyordu.
        -->
        <ListBox Grid.Row="2" x:Name="HistoryListBox" BorderThickness="1"
                 HorizontalContentAlignment="Stretch"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Border BorderThickness="0,0,0,1" BorderBrush="{DynamicResource MahApps.Brushes.Gray7}" Padding="8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0" Text="{Binding StatusGlyph}" FontSize="18" FontWeight="Bold"
                                       Foreground="{Binding StatusColor}" VerticalAlignment="Top" Margin="0,0,12,0" />

                            <StackPanel Grid.Column="1">
                                <TextBlock TextWrapping="Wrap">
                                    <Run Text="{Binding JobName, Mode=OneWay}" FontWeight="SemiBold" />
                                    <Run Text="{Binding WhenText, Mode=OneWay}" />
                                </TextBlock>
                                <TextBlock Text="{Binding MetaText}" Opacity="0.7" FontSize="11" Margin="0,2,0,0" TextWrapping="Wrap" />
                                <TextBlock Text="{Binding DetailText}" FontSize="11" Margin="0,4,0,0" TextWrapping="Wrap" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,16,0,0">
            <Button Content="{loc:Tr Common_Refresh}" Click="OnRefreshClick" Margin="0,0,8,0" />
            <Button Content="{loc:Tr Common_Close}" Click="OnCloseClick" />
        </StackPanel>
    </Grid>
</mah:MetroWindow>
