<mah:MetroWindow x:Class="FalcrebCloudBackup.App.CloudConnectionsWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
                 xmlns:loc="clr-namespace:FalcrebCloudBackup.App.Localization"
                 Title="{loc:Tr Cloud_Title}"
                 Icon="pack://application:,,,/Assets/logo_icon.png"
                 TitleCharacterCasing="Normal"
                 Width="560" Height="520"
                 MinWidth="480" MinHeight="380"
                 WindowStartupLocation="CenterOwner"
                 Closing="OnWindowClosing">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24">
            <TextBlock Text="{loc:Tr Cloud_Title}" FontSize="20" FontWeight="Light" Margin="0,0,0,16" />

            <Border BorderThickness="1" BorderBrush="{DynamicResource MahApps.Brushes.Gray7}" Padding="16" Margin="0,0,0,12" CornerRadius="4">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Google Drive" FontWeight="SemiBold" />
                        <TextBlock x:Name="GoogleDriveStatusText" Opacity="0.7" Margin="0,4,0,0" TextWrapping="Wrap" />
                        <ProgressBar x:Name="GoogleDriveQuotaBar" Height="7" Minimum="0" Maximum="100" Margin="0,8,12,0" Visibility="Collapsed" />
                        <TextBlock x:Name="GoogleDriveQuotaText" FontSize="11" Opacity="0.75" Margin="0,4,0,0" TextWrapping="Wrap" Visibility="Collapsed" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock x:Name="GoogleDriveCheckmark" Text="&#x2713;" FontWeight="Bold" FontSize="16"
                                   Foreground="#2FB344" VerticalAlignment="Center" Margin="0,0,8,0" Visibility="Collapsed" />
                        <Button x:Name="GoogleDriveDisconnectButton" Content="{loc:Tr Cloud_Disconnect}" Click="OnDisconnectGoogleDriveClick" Margin="0,0,8,0" Visibility="Collapsed" />
                        <Button x:Name="GoogleDriveConnectButton" Content="{loc:Tr Cloud_Connect}" Click="OnConnectGoogleDriveClick" />
                    </StackPanel>
                </Grid>
            </Border>

            <Border BorderThickness="1" BorderBrush="{DynamicResource MahApps.Brushes.Gray7}" Padding="16" Margin="0,0,0,12" CornerRadius="4">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="OneDrive" FontWeight="SemiBold" />
                        <TextBlock x:Name="OneDriveStatusText" Opacity="0.7" Margin="0,4,0,0" TextWrapping="Wrap" />
                        <ProgressBar x:Name="OneDriveQuotaBar" Height="7" Minimum="0" Maximum="100" Margin="0,8,12,0" Visibility="Collapsed" />
                        <TextBlock x:Name="OneDriveQuotaText" FontSize="11" Opacity="0.75" Margin="0,4,0,0" TextWrapping="Wrap" Visibility="Collapsed" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock x:Name="OneDriveCheckmark" Text="&#x2713;" FontWeight="Bold" FontSize="16"
                                   Foreground="#2FB344" VerticalAlignment="Center" Margin="0,0,8,0" Visibility="Collapsed" />
                        <Button x:Name="OneDriveDisconnectButton" Content="{loc:Tr Cloud_Disconnect}" Click="OnDisconnectOneDriveClick" Margin="0,0,8,0" Visibility="Collapsed" />
                        <Button x:Name="OneDriveConnectButton" Content="{loc:Tr Cloud_Connect}" Click="OnConnectOneDriveClick" />
                    </StackPanel>
                </Grid>
            </Border>

            <!--
                Uygulama yönetici yetkisiyle çalıştığı için başlattığı tarayıcı, normal kullanıcı
                olarak zaten açık olan bir Chrome/Edge varsa açılır açılmaz kapanabiliyor. O durumda
                kullanıcı burada görünen adresi kopyalayıp elle yapıştırarak girişi tamamlayabilir.
            -->
            <Border x:Name="AuthUrlPanel" Visibility="Collapsed" BorderThickness="1" BorderBrush="#E08A1E"
                    Background="#26E08A1E" CornerRadius="6" Padding="14" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="{loc:Tr Cloud_AuthWaitTitle}" FontWeight="SemiBold" Margin="0,0,0,4" />
                    <TextBlock TextWrapping="Wrap" FontSize="11" Opacity="0.85" Margin="0,0,0,10"
                               Text="{loc:Tr Cloud_AuthWaitHint}" />
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" x:Name="AuthUrlBox" IsReadOnly="True" FontSize="11" />
                        <Button Grid.Column="1" x:Name="CopyAuthUrlButton" Content="{loc:Tr Cloud_Copy}" Click="OnCopyAuthUrlClick"
                                Margin="8,0,0,0" Padding="12,6" IsEnabled="False" />
                    </Grid>
                    <Button x:Name="CancelConnectButton" Content="{loc:Tr Cloud_CancelConnect}" Click="OnCancelConnectClick"
                            HorizontalAlignment="Left" Padding="12,6" />
                </StackPanel>
            </Border>

            <Button x:Name="RefreshQuotaButton" Content="{loc:Tr Cloud_RefreshQuota}" Click="OnRefreshQuotaClick"
                    HorizontalAlignment="Left" Margin="0,0,0,8" />

            <TextBlock x:Name="InfoText" TextWrapping="Wrap" Opacity="0.75" FontSize="11" Margin="0,4,0,0" />
        </StackPanel>
    </ScrollViewer>
</mah:MetroWindow>
