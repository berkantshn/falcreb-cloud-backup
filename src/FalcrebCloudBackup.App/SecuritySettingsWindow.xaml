<mah:MetroWindow x:Class="FalcrebCloudBackup.App.SecuritySettingsWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
                 xmlns:loc="clr-namespace:FalcrebCloudBackup.App.Localization"
                 Title="{loc:Tr Sec_Title}"
                 Icon="pack://application:,,,/Assets/logo_icon.png"
                 TitleCharacterCasing="Normal"
                 Width="440" Height="520"
                 WindowStartupLocation="CenterOwner"
                 ResizeMode="NoResize">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24">
            <TextBlock Text="{loc:Tr Sec_Title}" FontSize="20" FontWeight="Light" Margin="0,0,0,16" />

            <Border BorderThickness="1" BorderBrush="{DynamicResource MahApps.Brushes.Gray7}" Padding="16" Margin="0,0,0,12" CornerRadius="4">
                <StackPanel>
                    <CheckBox x:Name="PinEnabledCheck" Content="{loc:Tr Sec_PinEnabled}" Checked="OnPinEnabledChanged" Unchecked="OnPinEnabledChanged" />
                </StackPanel>
            </Border>

            <Border BorderThickness="1" BorderBrush="{DynamicResource MahApps.Brushes.Gray7}" Padding="16" Margin="0,0,0,12" CornerRadius="4">
                <StackPanel>
                    <TextBlock Text="{loc:Tr Sec_TotpTitle}" FontWeight="SemiBold" Margin="0,0,0,4" />
                    <TextBlock x:Name="TotpStatusText" Opacity="0.7" Margin="0,0,0,8" />

                    <Button x:Name="EnableTotpButton" Content="{loc:Tr Sec_Enable}" Click="OnEnableTotpClick" HorizontalAlignment="Left" Margin="0,0,0,8" />
                    <Button x:Name="DisableTotpButton" Content="{loc:Tr Sec_Remove}" Click="OnDisableTotpClick" HorizontalAlignment="Left" Margin="0,0,0,8" />

                    <StackPanel x:Name="TotpSetupPanel" Visibility="Collapsed" Margin="0,8,0,0">
                        <TextBlock Text="{loc:Tr Sec_ScanPrompt}" TextWrapping="Wrap" Margin="0,0,0,12" />
                        <Image x:Name="QrImage" Width="180" Height="180" HorizontalAlignment="Left" Margin="0,0,0,12" />
                        <TextBlock Text="{loc:Tr Sec_ManualKey}" Margin="0,0,0,4" />
                        <TextBox x:Name="ManualKeyText" IsReadOnly="True" Margin="0,0,0,12" />
                        <TextBlock Text="{loc:Tr Sec_ConfirmPrompt}" Margin="0,0,0,4" />
                        <TextBox x:Name="ConfirmCodeBox" mah:TextBoxHelper.Watermark="{loc:Tr Sec_CodeWatermark}" Margin="0,0,0,12" />
                        <TextBlock x:Name="TotpErrorText" Foreground="Red" TextWrapping="Wrap" Margin="0,0,0,8" />
                        <StackPanel Orientation="Horizontal">
                            <Button Content="{loc:Tr Sec_Confirm}" Click="OnConfirmTotpClick" Margin="0,0,8,0" />
                            <Button Content="{loc:Tr Common_Cancel}" Click="OnCancelTotpSetupClick" />
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </Border>

            <TextBlock x:Name="GeneralErrorText" Foreground="Red" TextWrapping="Wrap" Margin="0,0,0,8" />

            <Button Content="{loc:Tr Common_Close}" Click="OnCloseClick" HorizontalAlignment="Right" />
        </StackPanel>
    </ScrollViewer>
</mah:MetroWindow>
