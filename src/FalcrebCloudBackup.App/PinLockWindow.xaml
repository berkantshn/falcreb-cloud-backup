<mah:MetroWindow x:Class="FalcrebCloudBackup.App.PinLockWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
                 xmlns:loc="clr-namespace:FalcrebCloudBackup.App.Localization"
                 xmlns:controls="clr-namespace:FalcrebCloudBackup.App.Controls"
                 Title="FalcrebCloudBackup"
                 Icon="pack://application:,,,/Assets/logo_icon.png"
                 Width="400" Height="460"
                 WindowStartupLocation="CenterScreen"
                 ResizeMode="NoResize"
                 ShowMinButton="False" ShowMaxRestoreButton="False"
                 TitleCharacterCasing="Normal"
                 GlowBrush="{DynamicResource MahApps.Brushes.Accent}">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <controls:BrandMark Grid.Row="0" IconHeight="44" TextSize="21" HorizontalAlignment="Center" Margin="0,0,0,24" />

        <!-- İlk kurulum: PIN belirleme -->
        <StackPanel x:Name="SetupPanel" Grid.Row="1" Visibility="Collapsed">
            <TextBlock Text="{loc:Tr Pin_SetupPrompt}" TextWrapping="Wrap" Margin="0,0,0,16" />
            <TextBlock Text="{loc:Tr Pin_New}" FontSize="11" Opacity="0.7" Margin="0,0,0,4" />
            <PasswordBox x:Name="SetupPinBox" Margin="0,0,0,12" />
            <TextBlock Text="{loc:Tr Pin_NewConfirm}" FontSize="11" Opacity="0.7" Margin="0,0,0,4" />
            <PasswordBox x:Name="SetupPinConfirmBox" Margin="0,0,0,16" />
            <TextBlock x:Name="SetupErrorText" Foreground="Red" TextWrapping="Wrap" Margin="0,0,0,8" />
            <Button Content="{loc:Tr Pin_Create}" Click="OnSetupPinClick" />
        </StackPanel>

        <!-- Normal açılış: PIN ve/veya authenticator kodu ile kilit açma -->
        <StackPanel x:Name="UnlockPanel" Grid.Row="1" Visibility="Collapsed">
            <TextBlock x:Name="UnlockPinLabel" Text="PIN" FontSize="11" Opacity="0.7" Margin="0,0,0,4" />
            <PasswordBox x:Name="UnlockPinBox" Margin="0,0,0,12" />
            <TextBlock x:Name="UnlockTotpLabel" Text="{loc:Tr Pin_TotpLabel}" FontSize="11" Opacity="0.7" Margin="0,0,0,4" />
            <TextBox x:Name="UnlockTotpBox" Margin="0,0,0,12" />
            <TextBlock x:Name="UnlockErrorText" Foreground="Red" TextWrapping="Wrap" Margin="0,0,0,8" />
            <Button Content="{loc:Tr Pin_Unlock}" Click="OnUnlockClick" Margin="0,0,0,8" />
            <Button Content="{loc:Tr Pin_CantSignIn}" Click="OnForgotPinClick" />
        </StackPanel>

        <!-- Kurtarma kodu ile PIN sıfırlama -->
        <StackPanel x:Name="RecoverPanel" Grid.Row="1" Visibility="Collapsed">
            <TextBlock Text="{loc:Tr Pin_RecoverPrompt}" TextWrapping="Wrap" Margin="0,0,0,16" />
            <TextBlock Text="{loc:Tr Pin_RecoveryCode}" FontSize="11" Opacity="0.7" Margin="0,0,0,4" />
            <TextBox x:Name="RecoveryCodeBox" Margin="0,0,0,12" />
            <TextBlock Text="{loc:Tr Pin_RecoverNew}" FontSize="11" Opacity="0.7" Margin="0,0,0,4" />
            <PasswordBox x:Name="RecoverNewPinBox" Margin="0,0,0,16" />
            <TextBlock x:Name="RecoverErrorText" Foreground="Red" TextWrapping="Wrap" Margin="0,0,0,8" />
            <Button Content="{loc:Tr Pin_Reset}" Click="OnResetPinClick" Margin="0,0,0,8" />
            <Button Content="{loc:Tr Pin_Back}" Click="OnBackToUnlockClick" />
        </StackPanel>
    </Grid>
</mah:MetroWindow>
