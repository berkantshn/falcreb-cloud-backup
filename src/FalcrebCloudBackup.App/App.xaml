<Application x:Class="FalcrebCloudBackup.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/MahApps.Metro;component/Styles/Controls.xaml" />
                <ResourceDictionary Source="pack://application:,,,/MahApps.Metro;component/Styles/Fonts.xaml" />
                <!-- Actual light/dark theme is applied at startup via ThemeManager (App.xaml.cs), not merged statically here, so the app can switch at runtime. -->
            </ResourceDictionary.MergedDictionaries>

            <!--
                MahApps' defaults follow the old "Metro" (Windows 8, ~2012) language: uppercase
                titles/buttons, square corners. These overrides pull the same controls toward a
                current look (mixed-case text, rounded corners) without touching MahApps' templates.
                BasedOn açık anahtarla verilir: {x:Type ...} burada kendi kendine çözülüp boş kalıyor ve
                denetimler MahApps şablonunu kaybediyordu.
            -->
            <Style TargetType="Button" BasedOn="{StaticResource MahApps.Styles.Button}">
                <Setter Property="mah:ControlsHelper.ContentCharacterCasing" Value="Normal" />
                <Setter Property="mah:ControlsHelper.CornerRadius" Value="6" />
                <Setter Property="Padding" Value="16,9" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Cursor" Value="Hand" />
            </Style>

            <Style TargetType="TextBox" BasedOn="{StaticResource MahApps.Styles.TextBox}">
                <Setter Property="mah:TextBoxHelper.UseFloatingWatermark" Value="False" />
                <Setter Property="mah:ControlsHelper.CornerRadius" Value="6" />
                <Setter Property="Padding" Value="10,8" />
            </Style>

            <Style TargetType="PasswordBox" BasedOn="{StaticResource MahApps.Styles.PasswordBox}">
                <Setter Property="mah:TextBoxHelper.UseFloatingWatermark" Value="False" />
                <Setter Property="mah:ControlsHelper.CornerRadius" Value="6" />
                <Setter Property="Padding" Value="10,8" />
            </Style>

            <Style TargetType="ComboBox" BasedOn="{StaticResource MahApps.Styles.ComboBox}">
                <Setter Property="mah:ControlsHelper.CornerRadius" Value="6" />
                <Setter Property="Padding" Value="10,8" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
