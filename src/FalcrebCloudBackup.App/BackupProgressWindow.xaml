<mah:MetroWindow x:Class="FalcrebCloudBackup.App.BackupProgressWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
                 xmlns:loc="clr-namespace:FalcrebCloudBackup.App.Localization"
                 Title="{loc:Tr Progress_Title}"
                 Icon="pack://application:,,,/Assets/logo_icon.png"
                 TitleCharacterCasing="Normal"
                 Width="440" Height="380"
                 WindowStartupLocation="CenterOwner"
                 ResizeMode="NoResize"
                 ShowMinButton="False" ShowMaxRestoreButton="False">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock x:Name="JobNameText" Grid.Row="0" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,12" TextWrapping="Wrap" />

        <ProgressBar x:Name="ProgressBarControl" Grid.Row="1" IsIndeterminate="True" Height="6" Margin="0,0,0,16" />

        <ListBox Grid.Row="2" x:Name="LogListBox" BorderThickness="1">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <TextBlock Text="{Binding}" FontSize="12" Margin="2" TextWrapping="Wrap" />
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <Button x:Name="CloseButton" Grid.Row="3" Content="{loc:Tr Common_Close}" HorizontalAlignment="Right"
                Margin="0,16,0,0" IsEnabled="False" Click="OnCloseClick" />
    </Grid>
</mah:MetroWindow>
