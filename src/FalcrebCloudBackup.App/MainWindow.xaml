<mah:MetroWindow x:Class="FalcrebCloudBackup.App.MainWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
                 xmlns:loc="clr-namespace:FalcrebCloudBackup.App.Localization"
                 xmlns:tb="http://www.hardcodet.net/taskbar"
                 xmlns:controls="clr-namespace:FalcrebCloudBackup.App.Controls"
                 Title="FalcrebCloudBackup"
                 Icon="pack://application:,,,/Assets/logo_icon.png"
                 Width="860" Height="640"
                 MinWidth="800" MinHeight="520"
                 WindowStartupLocation="CenterScreen"
                 TitleCharacterCasing="Normal"
                 StateChanged="OnStateChanged"
                 Activated="OnActivated"
                 Closing="OnClosing">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <tb:TaskbarIcon x:Name="TrayIcon"
                         ToolTipText="FalcrebCloudBackup"
                         TrayMouseDoubleClick="OnTrayDoubleClick">
            <tb:TaskbarIcon.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="{loc:Tr Tray_Open}" Click="OnTrayDoubleClick" />
                    <Separator />
                    <MenuItem Header="{loc:Tr Tray_Exit}" Click="OnExitClick" />
                </ContextMenu>
            </tb:TaskbarIcon.ContextMenu>
        </tb:TaskbarIcon>

        <Grid Grid.Row="0" Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <controls:BrandMark Grid.Column="0" IconHeight="48" TextSize="23" HorizontalAlignment="Left" />
            <CheckBox x:Name="AutoStartCheckBox" Grid.Column="1" Content="{loc:Tr Main_AutoStart}"
                      VerticalAlignment="Center" Margin="0,0,16,0" Checked="OnAutoStartChanged" Unchecked="OnAutoStartChanged" />
            <Button x:Name="ThemeToggleButton" Grid.Column="2" Content="{loc:Tr Main_ThemeDark}" Click="OnThemeToggleClick" VerticalAlignment="Center" />
            <Button x:Name="LockButton" Grid.Column="3" Click="OnLockButtonClick" VerticalAlignment="Center" Margin="8,0,0,0" MinWidth="118">
                <StackPanel Orientation="Horizontal">
                    <TextBlock x:Name="LockGlyphText" Text="&#x1F512;" FontSize="14" Margin="0,0,6,0" VerticalAlignment="Center" />
                    <TextBlock x:Name="LockStatusText" Text="{loc:Tr Main_Locked}" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
        </Grid>

        <!-- Sorun şeridi: bir görev başarısızsa ya da uzun süredir yedek yoksa burada, listeye bakmadan görünür. -->
        <Border Grid.Row="1" x:Name="StatusBanner" Visibility="Collapsed" CornerRadius="6" Padding="14,10" Margin="0,0,0,16"
                BorderThickness="1" BorderBrush="#E08A1E" Background="#26E08A1E">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="StatusBannerGlyph" Grid.Column="0" Text="⚠" FontSize="18" FontWeight="Bold" Foreground="#E08A1E" VerticalAlignment="Top" Margin="0,0,12,0" />
                <StackPanel Grid.Column="1">
                    <TextBlock x:Name="StatusBannerTitle" FontWeight="SemiBold" TextWrapping="Wrap" />
                    <TextBlock x:Name="StatusBannerText" TextWrapping="Wrap" Opacity="0.85" Margin="0,2,0,0" />
                </StackPanel>
            </Grid>
        </Border>

        <TextBlock Grid.Row="2" Text="{loc:Tr Main_JobsTitle}" FontSize="22" FontWeight="Light" Margin="0,0,0,4" />
        <TextBlock Grid.Row="3" x:Name="SubtitleText" Opacity="0.7" Margin="0,0,0,12" TextWrapping="Wrap" />

        <ListBox Grid.Row="4" x:Name="JobsListBox" BorderThickness="1"
                 SelectionChanged="OnJobSelectionChanged"
                 MouseDoubleClick="OnJobDoubleClick"
                 HorizontalContentAlignment="Stretch"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid Margin="6,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0" Text="{Binding StatusGlyph}" FontSize="20" FontWeight="Bold"
                                   Foreground="{Binding StatusBrush}" VerticalAlignment="Top" Margin="2,0,14,0" />

                        <StackPanel Grid.Column="1">
                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="14" />
                            <TextBlock Text="{Binding SourcePath}" Opacity="0.7" FontSize="11" Margin="0,2,0,0" TextWrapping="Wrap" />
                            <TextBlock FontSize="11" Opacity="0.55" Margin="0,2,0,0" TextWrapping="Wrap">
                                <Run Text="{Binding DestinationsSummary, Mode=OneWay}" />
                                <Run Text=" · " />
                                <Run Text="{Binding ScheduleText, Mode=OneWay}" />
                            </TextBlock>
                            <TextBlock FontSize="12" Margin="0,6,0,0" TextWrapping="Wrap">
                                <Run Text="{Binding StatusSummary, Mode=OneWay}" Foreground="{Binding StatusBrush}" FontWeight="SemiBold" />
                                <Run Text="{Binding StatusDetailWithSeparator, Mode=OneWay}" />
                            </TextBlock>
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <Grid Grid.Row="5" Margin="0,16,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!--
                Bulut alanı göstergesi. Uygulama ilke gereği hiçbir yedeği silmediği için kullanılan
                alan her gün artar; dolduğunda yüklemeler sessizce başarısız olmaya başlar. Değer
                son başarılı yüklemede okunup saklandığından burası ağa hiç çıkmaz.
            -->
            <ItemsControl Grid.Row="0" x:Name="QuotaList" Visibility="Collapsed" Margin="0,0,0,12">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="0,0,0,5">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="105" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{Binding ProviderName}" FontSize="11" Opacity="0.8" VerticalAlignment="Center" />
                            <ProgressBar Grid.Column="1" Height="7" Minimum="0" Maximum="100"
                                         Value="{Binding Percent, Mode=OneWay}"
                                         Foreground="{Binding BarBrush}" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="2" Text="{Binding Summary}" FontSize="11" Margin="10,0,0,0"
                                       VerticalAlignment="Center" Foreground="{Binding TextBrush}" />
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <StackPanel Grid.Row="1" Orientation="Horizontal">
                <Button Content="{loc:Tr Main_NewJob}" Click="OnNewJobClick" Margin="0,0,8,0" />
                <Button x:Name="EditButton" Content="{loc:Tr Main_Edit}" Click="OnEditJobClick" Margin="0,0,8,0" IsEnabled="False" />
                <Button x:Name="RemoveButton" Content="{loc:Tr Main_Remove}" Click="OnRemoveJobClick" Margin="0,0,8,0" IsEnabled="False" />
                <Button x:Name="RunNowButton" Content="{loc:Tr Main_RunNow}" Click="OnRunNowClick" IsEnabled="False" />
            </StackPanel>
            <Grid Grid.Row="2" Margin="0,8,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <Button Content="{loc:Tr Main_CloudConnections}" Click="OnCloudConnectionsClick" Margin="0,0,8,0" />
                    <Button Content="{loc:Tr Main_Notifications}" Click="OnNotificationsClick" Margin="0,0,8,0" />
                    <Button Content="{loc:Tr Main_History}" Click="OnHistoryClick" Margin="0,0,8,0" />
                    <Button Content="{loc:Tr Main_Logs}" Click="OnLogsClick" Margin="0,0,8,0" />
                    <Button Content="{loc:Tr Main_Security}" Click="OnSecuritySettingsClick" />
                </StackPanel>
                <!-- Dil seçimi: dil adları bilerek çevrilmez; karşılaştırma Tag ile yapılır. -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,0,0">
                    <TextBlock Text="{loc:Tr Main_Language}" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <ComboBox x:Name="LanguageCombo" Width="104" SelectionChanged="OnLanguageChanged">
                        <ComboBoxItem Content="English" Tag="en" />
                        <ComboBoxItem Content="Türkçe" Tag="tr" />
                    </ComboBox>
                </StackPanel>
            </Grid>
        </Grid>

        <StackPanel Grid.Row="6" Margin="0,16,0,0" HorizontalAlignment="Center">
        <TextBlock x:Name="UpdateNotice" Visibility="Collapsed" HorizontalAlignment="Center" Margin="0,0,0,6" FontWeight="SemiBold">
            <Run x:Name="UpdateNoticeText" Text="" />
            <Hyperlink x:Name="UpdateInstallLink" Click="OnInstallUpdateClick"><Run Text="{loc:Tr Update_Install}" /></Hyperlink>
        </TextBlock>
        <CheckBox x:Name="UpdateCheckCheckBox" HorizontalAlignment="Center" Margin="0,0,0,6" FontSize="11" Content="{loc:Tr Main_CheckUpdates}"
                  Checked="OnUpdateCheckChanged" Unchecked="OnUpdateCheckChanged" />
        <TextBlock HorizontalAlignment="Center" FontSize="11" Opacity="0.6">
            <Run x:Name="VersionText" Text="" />
            <Run Text=" · Made By FALCREB · " />
            <Hyperlink NavigateUri="https://github.com/berkantshn/falcreb-cloud-backup/issues" RequestNavigate="OnSupportLinkClick">GitHub Issues</Hyperlink>
        </TextBlock>
        </StackPanel>
    </Grid>
</mah:MetroWindow>
